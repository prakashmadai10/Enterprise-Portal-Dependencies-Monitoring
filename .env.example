# Portal connection. Leave PORTAL_URL empty to use GIS("home") inside an ArcGIS Notebook.
PORTAL_URL=
PORTAL_USERNAME=
PORTAL_PASSWORD=

# Item ID of the hosted tables (printed by create_enterprise_tables.py)
DASHBOARD_TABLES_ID=

# true/false: also resolve Feature Service URLs to item IDs (about 2x slower)
CHECK_URLS=false

# Logging: file path (default logs/dependencies_monitor.log) and level (INFO or DEBUG)
LOG_FILE=logs/dependencies_monitor.log
LOG_LEVEL=INFO

# Item owners to leave out (comma-separated, * wildcard). Default skips Esri system accounts.
EXCLUDE_OWNERS=esri_*

# Item ID of the dashboard that create_dashboard.py updates (filled in on first create)
DASHBOARD_ID=

# true: share the tables item and the dashboard with the whole organization
SHARE_WITH_ORG=false

# Dashboards version written into the dashboard (must not be newer than the portal supports;
# Enterprise 11.5 accepts 4.32.0). See the README for how to find yours.
DASHBOARD_VERSION=4.32.0

# Dashboard titles (optional)
DASHBOARD_TITLE=Dependencies Monitoring Dashboard
DASHBOARD_HEADER_TITLE=Portal Dependencies Monitoring
